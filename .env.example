# Configuration de l'application Comm'Generator
# Copiez ce fichier en .env et ajustez les valeurs selon votre environnement

# Niveau de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Configuration du cache
CACHE_DIR=/tmp/comm_generator_cache
CACHE_EXPIRY_MINUTES=60

# Configuration du serveur
HOST=0.0.0.0
PORT=8000
RELOAD=false

# Environnement (development, production)
ENVIRONMENT=production

# Chemins (optionnels, utilise les valeurs par défaut si non spécifiés)
# CONFIG_FILE=config.yaml
# SAISONS_FILE=saisons.yaml
# TEAM_RULES_FILE=team_rules.yaml
